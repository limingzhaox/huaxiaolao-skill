  "claims": [
    {
      "id": "C01",
      "statement": "日常看到的月面亮光主要是月球表面反射的太阳光；昼间也使用同一光路。",
      "kind": "fact",
      "verification": "verified",
      "sources": [
        {
          "url": "https://www.nasa.gov/solar-system/why-can-you-see-the-moon-during-the-day-we-asked-a-nasa-scientist-episode-19/",
          "locator": "正文视频文字稿，第2段（Unlike our Sun开头）；网页提取L257–259",
          "supports": "月球不靠自身发出的可见光照亮月面，白天与夜间均可见其反射的太阳光。"
        }
      ],
      "limits": "本集讲肉眼看到的太阳照亮月面，不展开地照或月球热辐射；不把月面画成镜面或自身灯泡。",
      "voice_line_ids": [
        "V03"
      ],
      "scene_ids": [
        "S02"
      ]
    },
    {
      "id": "C02",
      "statement": "地球自转会让地表观察者所在地区迎向或背向太阳，形成昼夜。",
      "kind": "fact",
      "verification": "verified",
      "sources": [
        {
          "url": "https://www.lpi.usra.edu/education/skytellers/day_night/",
          "locator": "Why Does Earth Have Day and Night? 首段；网页提取L68–69",
          "supports": "地球自转把观察者带到迎着太阳或背向太阳的一侧，产生昼夜；从北极上方看自转逆时针。"
        }
      ],
      "limits": "用远离极昼极夜和晨昏边界的一般昼间情境；不是地球绕太阳一次形成一天。",
      "voice_line_ids": [
        "V04"
      ],
      "scene_ids": [
        "S03"
      ]
    },
    {
      "id": "C03",
      "statement": "白天时，月亮也可能位于观察者的地平线上方，太阳和月亮可以同时处于其地面可见的天空。",
      "kind": "fact",
      "verification": "verified",
      "sources": [
        {
          "url": "https://www.nasa.gov/solar-system/why-can-you-see-the-moon-during-the-day-we-asked-a-nasa-scientist-episode-19/",
          "locator": "正文视频文字稿，第2段（Unlike our Sun开头）；网页提取L257–259",
          "supports": "月亮在白天天空中出现是正常现象。"
        },
        {
          "kind": "derivation",
          "locator": "本包S03平面几何示意；忽略折射与遮挡",
          "supports": "同一观察点的地平线上方可同时包含太阳方向和月亮方向，两者无须互斥。",
          "method": "地球截面圆心E=(540,400)、半径90，观察点P=E+90*(-1,-1)/sqrt(2)。当地天顶向量n=(-1,-1)/sqrt(2)。太阳方向s=(-1,0)，n·s>0；月球示意位置M=(530,100)，n·(M-P)>0。太阳与月球方向均在当地地平线上方。"
        }
      ],
      "limits": "“在上方”只是能看见的必要条件之一；不保证一直可见。图不按距离或尺寸比例，不处理地形、折射、天气。",
      "voice_line_ids": [
        "V05",
        "V09"
      ],
      "scene_ids": [
        "S03",
        "S05",
        "S07"
      ]
    },
    {
      "id": "C04",
      "statement": "月球绕地球运动，月球与太阳在地球天空中的相对方向会变化，月亮没有与太阳固定互换的升落时刻。",
      "kind": "fact",
      "verification": "verified",
      "sources": [
        {
          "url": "https://science.nasa.gov/moon/moon-phases/",
          "locator": "3 Quick Facts；New Moon；Daytime Moons；Overview From Space；网页提取L292–324、L332–339、L382–404",
          "supports": "月球轨道运动、不同月相对应不同的大致升落时段；白天可见时段与月相、季节和地点相关。"
        }
      ],
      "limits": "不报每日固定推迟几分钟，不把不同日期位置跳切当作实时速度；不提供本地观测预报。",
      "voice_line_ids": [
        "V06"
      ],
      "scene_ids": [
        "S04"
      ]
    },
    {
      "id": "C05",
      "statement": "白天天空受散射太阳光照亮，降低月面与背景的显眼程度；在适当条件下仍能辨认月亮。",
      "kind": "fact",
      "verification": "verified",
      "sources": [
        {
          "url": "https://spaceplace.nasa.gov/blue-sky/en/",
          "locator": "The Short Answer；正文关于大气散射的段落；网页提取L13–15、L36–46",
          "supports": "太阳光进入大气后被空气分子等散射，形成明亮的白天天空。"
        },
        {
          "url": "https://www.nasa.gov/solar-system/why-can-you-see-the-moon-during-the-day-we-asked-a-nasa-scientist-episode-19/",
          "locator": "正文视频文字稿，第2段（Unlike our Sun开头）；网页提取L257–259",
          "supports": "明亮的白天天空中，条件与天空位置合适时月亮仍足够明显，可被看见。"
        }
      ],
      "limits": "相同月面加两种背景是阅读对比示意，不是亮度测量。并非月球白天熄灭或变透明；可见性还随月相、天空状况、太阳角距等改变。",
      "voice_line_ids": [
        "V08",
        "V09",
        "V12"
      ],
      "scene_ids": [
        "S05",
        "S07"
      ]
    },
    {
      "id": "C06",
      "statement": "新月时，月球通常与太阳大致同升落，面向地球的一面基本没有被太阳直接照亮，从地球看又接近太阳方向，通常肉眼看不见。",
      "kind": "fact",
      "verification": "verified",
      "sources": [
        {
          "url": "https://science.nasa.gov/moon/moon-phases/",
          "locator": "New Moon段；Daytime Moons最后一项；网页提取L332–333、L389–397",
          "supports": "New Moon与Daytime Moons条目支持新月的相对位置、照亮方向、同升落与不可见性。"
        }
      ],
      "limits": "讲通常新月，不展开地照和日食；轨道有倾角，不把每次新月画成精确遮住太阳；“基本”不写成整个月球没有被照亮。",
      "voice_line_ids": [
        "V10",
        "V11"
      ],
      "scene_ids": [
        "S06"
      ]
    },
    {
      "id": "M01",
      "statement": "小猫以为太阳和月亮要交接班，掏出排班表催月亮下班。",
      "kind": "metaphor",
      "verification": "fictional",
      "sources": [],
